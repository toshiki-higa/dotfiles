# Environment variables -----------------
# Load the latest Home Manager session variables.
unset __HM_SESS_VARS_SOURCED
if [[ -r "/etc/profiles/per-user/$USER/etc/profile.d/hm-session-vars.sh" ]]; then
  source "/etc/profiles/per-user/$USER/etc/profile.d/hm-session-vars.sh"
elif [[ -r "$HOME/.nix-profile/etc/profile.d/hm-session-vars.sh" ]]; then
  source "$HOME/.nix-profile/etc/profile.d/hm-session-vars.sh"
fi
# Deduplicate paths
typeset -U path PATH

# Autocomplete ---------------------------
# Enable compsys
autoload -Uz compinit
compinit

# carapace: fill gaps for commands without native zsh completion
zmodload zsh/complist
zstyle ':completion:*' menu select
zstyle ':completion:*' group-name ''
zstyle ':completion:*' format $'\e[2;37mCompleting %d\e[m'
export CARAPACE_BRIDGES="zsh,fish,bash,inshellisense"
source <(carapace _carapace)

# direnv (installed with nix-direnv by Home Manager)
eval "$(direnv hook zsh)"

# mise
eval "$(mise activate zsh)"
eval "$(mise completion zsh)"

# uv(python) — load before sheldon plugins that wrap them
eval "$(uv generate-shell-completion zsh)"

# apps from home-manager/mise
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=#767676"
eval "$(sheldon source)"
eval "$(starship init zsh)"
eval "$(abbrs init zsh)"
eval "$(zoxide init zsh)"
eval "$(git-wt --init zsh)"
eval "$(bit completion zsh)"

# Alias ----------------------------------
alias ls='eza'
alias cat='bat --paging=never'
alias bw='rbw'
alias npx='print -u2 -- "npx is disabled. Use: pnpm dlx"; false'

# Shell functions ------------------------
function cd-repository() {
  local repo=$(ghq list | \
    fzf --layout reverse \
      --preview '
        sh -c '\''repo_path="$(ghq root)/$1"
        echo "📖 README"
        echo "----------------------------------------"
        readme_file=$(find "$repo_path" -maxdepth 1 -iname "README.*" -print -quit)
        [ -n "$readme_file" ] && bat --color=always --style=grid --line-range :80 "$readme_file" || echo "README file not found."
        echo
        echo "📂 Directory Structure"
        echo "----------------------------------------"
        eza --tree --git-ignore --color=always "$repo_path"
        '\'' _ {}
  ')
  if [ -n "$repo" ]; then
    cd $(ghq root)/$repo
  fi
}
alias cdr='cd-repository'
